# Environment variables for AgriNexus-AI Market Forecast Backend
# Copy this file to .env and fill in your actual values

# Government of India API key for agricultural market data
# Get your API key from data.gov.in or agmarknet.gov.in
DATA_GOV_API_KEY=your_api_key_here

# Optional: Base URLs for APIs (defaults will be used if not set)
# AGMARKNET_API_BASE_URL=https://api.data.gov.in/
# DATA_GOV_IN_BASE_URL=https://api.data.gov.in/

# ------------------------------------------------------------------
# Crop Calendar external provider (Spora) - OPTIONAL
# ------------------------------------------------------------------
# Official provider documentation: https://spora.engineer/docs
#   Base URL: https://api.spora.engineer  (documented default)
#   Auth:     "X-Api-Key" request header (the key alone is sufficient;
#             no username/password is required)
#   Endpoint: GET /harvest/{location}  (lowercase country slug)
# When SPORA_API_KEY is unset the Crop Calendar module serves the
# bundled reference dataset. When it is set, the module calls the Spora
# /harvest endpoint and falls back to the labelled reference dataset if
# the provider is unavailable.
# The key must remain backend-only: never commit it, never log it, and
# never expose it through API responses. backend/.env is git-ignored.
# SPORA_API_BASE_URL=https://api.spora.engineer
# SPORA_API_KEY=your_spora_api_key_here
# CROP_CALENDAR_FALLBACK_TO_REFERENCE_DATA=True

# Database configuration (SQLite default)
# DATABASE_URL=sqlite:///./data/market/market_data.db

# API settings
API_HOST=0.0.0.0
API_PORT=8000
DEBUG=False