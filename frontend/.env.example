# AgriNexus-AI Frontend Environment Configuration
# Copy this file to .env.local for local development

# Mapbox Public Access Token for interactive maps, search box & geocoding
# Get your token at https://account.mapbox.com/
VITE_MAPBOX_TOKEN=your_mapbox_public_token_here

# Backend FastAPI URL (defaults to proxy or relative URL)
VITE_API_BASE_URL=
